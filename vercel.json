{
  "functions": {
    "api/ehon.js": { "maxDuration": 60 },
    "api/ehon-image.js": { "maxDuration": 60 },
    "api/ehon-voice.js": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/ehon", "destination": "/ehon.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
